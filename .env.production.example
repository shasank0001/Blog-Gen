# Generate .env.production with ./deploy.sh init. Never commit the generated file.
POSTGRES_PASSWORD=GENERATE_DATABASE_PASSWORD
SECRET_KEY=GENERATE_SIGNING_SECRET

# Local preview. For a public server, use your domain and the settings below:
# SITE_ADDRESS=blog.example.com
# PUBLIC_BIND_ADDRESS=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443
SITE_ADDRESS=:80
PUBLIC_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443

# Accounts are created with ./deploy.sh create-user you@example.com.
ALLOW_REGISTRATION=false
CORS_ORIGINS='[]'
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Empty keys disable their features; the editor/login can run without them.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
FIRECRAWL_API_KEY=
PINECONE_API_KEY=
PINECONE_ENV=us-east-1
PINECONE_INDEX_NAME=content-strategist

# Enter actual provider rates before cloud generation. See backend/.env.example.
LLM_PRICING_JSON='{}'
DEFAULT_MONTHLY_LIMIT_USD=10
WORKER_CONCURRENCY=2
USE_LOCAL_LLM=false
USE_LOCAL_EMBEDDINGS=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5
LOCAL_EMBEDDING_MODEL=nomic-embed-text
